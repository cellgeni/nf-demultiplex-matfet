#!/usr/bin/env bash
#BSUB -J prepare_subset
#BSUB -q normal
#BSUB -n 1
#BSUB -M 8000
#BSUB -R "select[mem>=8000] rusage[mem=8000]"
#BSUB -o %J.prepare_subset.out
#BSUB -e %J.prepare_subset.err
#BSUB -Ep /software/cellgen/cellgeni/etc/notify-slack.sh
#
# Materialise one discovery subset as a column view of a built group matrix.
#
# Subsetting streams both matrices end to end -- 130M entries and ~3.8 GB for
# CW4 -- so it runs here rather than on the submitting host.
#
# Required: GROUP_DIR, OUTDIR, LABEL, MODE (libraries|balanced|cap)
#   MODE=libraries : LIBRARIES="a,b,c"
#   MODE=balanced  : PER_LIBRARY=N
#   MODE=cap       : TOTAL=N
# Optional: MIN_LOCI (default 1)
#
# Writes <OUTDIR>/cells_<LABEL>/cells.tsv and <OUTDIR>/subset_<LABEL>/<group_id>/

source /etc/profile >/dev/null || true
set -euo pipefail

HARNESS="${HARNESS:-/nfs/cellgeni/batu/_repos/nf-demux-preg/validation/group_matrix}"
GROUP_DIR="${GROUP_DIR:?set GROUP_DIR}"
OUTDIR="${OUTDIR:?set OUTDIR}"
LABEL="${LABEL:?set LABEL}"
MODE="${MODE:?set MODE to libraries, balanced or cap}"
MIN_LOCI="${MIN_LOCI:-1}"

args=(--group-dir "$GROUP_DIR" --outdir "$OUTDIR/cells_$LABEL" --mode "$MODE"
      --min-loci "$MIN_LOCI")
case "$MODE" in
  libraries) args+=(--libraries "${LIBRARIES:?set LIBRARIES for mode libraries}") ;;
  balanced)  args+=(--per-library "${PER_LIBRARY:?set PER_LIBRARY for mode balanced}") ;;
  cap)       args+=(--total "${TOTAL:?set TOTAL for mode cap}") ;;
  *) echo "ERROR: unknown MODE $MODE" >&2; exit 1 ;;
esac

echo "[$(date -Is)] selecting cells for $LABEL"
python3 "$HARNESS/common/select_cells.py" "${args[@]}"

echo "[$(date -Is)] materialising the column view"
python3 "$HARNESS/common/subset_group_matrix.py" \
  --group-dir "$GROUP_DIR" \
  --cells "$OUTDIR/cells_$LABEL/cells.tsv" \
  --outdir "$OUTDIR/subset_$LABEL"

echo "[$(date -Is)] done: $OUTDIR/subset_$LABEL"
