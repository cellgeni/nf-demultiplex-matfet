#!/usr/bin/env bash
#BSUB -J group_matrix
#BSUB -q normal
#BSUB -n 1
#BSUB -M 16000
#BSUB -R "select[mem>=16000] rusage[mem=16000]"
#BSUB -o %J.group_matrix.out
#BSUB -e %J.group_matrix.err
#BSUB -Ep /software/cellgen/cellgeni/etc/notify-slack.sh
#
# Gate 1: build a group matrix twice and run the integrity + determinism checks.
#
# Submit from a directory on lustre, e.g.:
#   source /etc/profile >/dev/null 2>&1 || true; source ~/.bashrc >/dev/null 2>&1 || true
#   cd /lustre/scratch127/cellgen/cellgeni/tickets/REQ-68805/actions
#   GROUP_ID=CW5 OUTDIR=/lustre/scratch127/cellgen/cellgeni/tickets/REQ-68805/group_matrix \
#     bsub -J group_matrix_CW5 < /nfs/cellgeni/batu/_repos/nf-demux-preg/validation/group_matrix/lsf/build_group.bsub
#
# CW5 is ~19k cells and ~38M entries per matrix: expect a few GB of output per
# build, and two builds are written so determinism can be proved. Raise -M for
# CW4 (five libraries) if the job is killed for memory.
# Execution hosts have no container runtime on PATH by default. cellgen/singularity
# is the runtime the completed pipeline used; cellgen/apptainer is non-suid and
# needs user namespaces that the exec hosts disallow, so it is only a fallback.
# This must run BEFORE the strict flags: /etc/profile is not written to be
# sourced under `set -u`, and an abort there would be silent.
source /etc/profile >/dev/null || true
module load "${CONTAINER_MODULE:-cellgen/singularity}" >/dev/null || true
set -euo pipefail
command -v singularity >/dev/null || { echo "ERROR: no singularity/apptainer on PATH" >&2; exit 1; }

HARNESS="${HARNESS:-/nfs/cellgeni/batu/_repos/nf-demux-preg/validation/group_matrix}"
GROUPS_CSV="${GROUPS_CSV:-$HARNESS/groups_validation.csv}"
GROUP_ID="${GROUP_ID:?set GROUP_ID, e.g. CW5}"
OUTDIR="${OUTDIR:?set OUTDIR on lustre}"
PANEL_VCF="${PANEL_VCF:-/nfs/cellgeni/pipeline-files/demultiplex/reference_vcfs/chr_filtered_2p_1kgenomes_GRCh38.vcf}"
IMAGE="${IMAGE:-/nfs/cellgeni/singularity/images/souporcell_v2.5-python_3.10-vireo_v0.5.8-cellsnp-lite_1.2.3-nextflow-compatible.sif}"

PRIMARY="$OUTDIR/build_a"
REPLICATE="$OUTDIR/build_b"
mkdir -p "$PRIMARY" "$REPLICATE"

echo "[$(date -Is)] building $GROUP_ID (primary)"
python3 "$HARNESS/build_group_matrix.py" \
  --groups "$GROUPS_CSV" --group-id "$GROUP_ID" --outdir "$PRIMARY" \
  --panel-vcf "$PANEL_VCF" --singularity-image "$IMAGE" \
  --singularity-bind "${SINGULARITY_BIND_PATHS:-/lustre,/nfs}"

echo "[$(date -Is)] building $GROUP_ID (replicate, for the determinism test)"
python3 "$HARNESS/build_group_matrix.py" \
  --groups "$GROUPS_CSV" --group-id "$GROUP_ID" --outdir "$REPLICATE" \
  --panel-vcf "$PANEL_VCF" --singularity-image "$IMAGE" --no-hash \
  --singularity-bind "${SINGULARITY_BIND_PATHS:-/lustre,/nfs}"

echo "[$(date -Is)] integrity check"
python3 "$HARNESS/check_group_matrix.py" \
  --groups "$GROUPS_CSV" --group-id "$GROUP_ID" --outdir "$PRIMARY" \
  --panel-vcf "$PANEL_VCF" --compare-dir "$REPLICATE"

echo "[$(date -Is)] done: $PRIMARY/$GROUP_ID"
