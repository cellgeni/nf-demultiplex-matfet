#!/usr/bin/env bash
#BSUB -J prepare_spikein
#BSUB -q normal
#BSUB -n 1
#BSUB -M 8000
#BSUB -R "select[mem>=8000] rusage[mem=8000]"
#BSUB -o %J.prepare_spikein.out
#BSUB -e %J.prepare_spikein.err
#BSUB -Ep /software/cellgen/cellgeni/etc/notify-slack.sh
#
# Materialise one spike-in group and its two halves as column views of the CW5
# build. The halves are cut from the group's own view, which is much smaller
# than CW5, so the second and third subsets are quick.
#
# Required: GROUP_DIR (the CW5 build), GDIR (<experiment>/groups/<label>)

source /etc/profile >/dev/null || true
set -euo pipefail

HARNESS="${HARNESS:-/nfs/cellgeni/batu/_repos/nf-demux-preg/validation/group_matrix}"
GROUP_DIR="${GROUP_DIR:?set GROUP_DIR to the CW5 build}"
GDIR="${GDIR:?set GDIR to the spike-in group directory}"
GROUP_ID="$(basename "$GROUP_DIR")"

echo "[$(date -Is)] group view"
python3 "$HARNESS/common/subset_group_matrix.py" --group-dir "$GROUP_DIR" \
  --cells "$GDIR/cells.tsv" --outdir "$GDIR/full"
for half in A B; do
  echo "[$(date -Is)] half $half"
  python3 "$HARNESS/common/subset_group_matrix.py" --group-dir "$GDIR/full/$GROUP_ID" \
    --cells "$GDIR/cells_$half.tsv" --outdir "$GDIR/$half"
done
echo "[$(date -Is)] done: $GDIR"
