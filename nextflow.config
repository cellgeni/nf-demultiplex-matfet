// nf-demultiplex-matfet — group-aware maternal/fetal demultiplexing pipeline
// See docs/pipeline_design.md for design rationale.

params {
    // --- input / output ---
    input   = null                       // samplesheet CSV: group_id,sample_id,bam,barcodes,expression[,...]
    outdir  = "results"

    // --- per-library Souporcell: remap + allele counts (reused nf-demultiplex defaults) ---
    // Its own K=2 clustering is kept only as a diagnostic; genotypes come from the group.
    souporcell_k    = 2
    known_genotypes = false
    soc_vcf         = '/nfs/cellgeni/pipeline-files/demultiplex/reference_vcfs/chr_filtered_2p_1kgenomes_GRCh38.vcf'
    soc_fasta       = '/nfs/cellgeni/STAR/human/2020A/GRCh38_v32_modified.fa'
    skip_remap      = false             // retain Souporcell's recommended remapping step
    no_umi          = false

    // --- group discovery (Souporcell K=2 on the group matrix) ---
    discovery_seed = 1                   // the seed every validation run used

    // --- composition gate (evidence: docs/pipeline_design.md, "Composition gate") ---
    gate_min_discordant_fraction = 0.40  // share of jointly called loci where the two profiles must differ
    gate_min_minority_singlets   = 20    // singlets the minority cluster needs to count as a profile

    // --- marker panel ---
    marker_panel = "${projectDir}/assets/marker_panel.tsv"

    // --- decision-engine thresholds (starting points; not yet calibrated on real groups) ---
    min_cluster_cells             = 50    // min singlets in a cluster for a confident call
    min_marker_detected_fraction  = 0.10  // frac-positive floor in the fetal-candidate cluster
    min_marker_fraction_delta     = 0.05  // min frac-positive difference between clusters
    min_marker_logfc              = 1.0   // min log2 enrichment (CP10K) between clusters
    rps4y1_fraction_floor         = 0.10  // RPS4Y1 frac-positive floor for the Tier-1 override
    rps4y1_min_fold               = 5.0   // RPS4Y1 enrichment fold for the Tier-1 override
    min_vote_margin               = 2     // min Tier-2 secondary-marker vote margin
    imbalance_warn_ratio          = 10.0  // cluster-size imbalance that triggers a warning

    // --- execution ---
    container = '/nfs/cellgeni/singularity/images/souporcell_v2.5-python_3.10-vireo_v0.5.8-cellsnp-lite_1.2.3-nextflow-compatible.sif'

    help = false
}

// Task work directory, relative to the launch directory. `-w` still overrides it.
workDir = 'nf-work'

// Provenance / reproducibility reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

includeConfig 'conf/base.config'

// Container execution is ALWAYS on. Every tool this pipeline calls
// (souporcell_pipeline.py, samtools, numpy/scipy) exists only inside params.container,
// so leaving the engine to an opt-in `-profile singularity` meant a bare
// `nextflow run main.nf` executed the task scripts on the bare host and died with
// exit 127 part-way into Souporcell. Enable it here so no profile can forget it.
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B /lustre,/nfs'
    cacheDir   = '/nfs/cellgeni/singularity/images'
}

profiles {
    standard {
        process.executor = 'local'
    }
    sanger {
        includeConfig 'conf/sanger.config'
    }
    // Kept so the documented `-profile sanger,singularity` invocation still works;
    // Singularity is enabled by default above.
    singularity {
        singularity.enabled = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name            = 'cellgeni/nf-demultiplex-matfet'
    description     = 'Group-aware maternal/fetal demultiplexing of single-cell pregnancy samples (Souporcell group discovery + composition gate + marker labeling)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '0.2.0-dev'
}
