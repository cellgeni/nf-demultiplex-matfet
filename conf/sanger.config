// Sanger FARM (IBM LSF + Singularity). Mirrors nf-demultiplex conventions.
// The only file in the repository with farm paths: the reference files, the image and its binds.

params {
    soc_vcf   = '/nfs/cellgeni/pipeline-files/demultiplex/reference_vcfs/chr_filtered_2p_1kgenomes_GRCh38.vcf'
    soc_fasta = '/nfs/cellgeni/STAR/human/2020A/GRCh38_v32_modified.fa'
    container = '/nfs/cellgeni/singularity/images/souporcell_v2.5-python_3.10-vireo_v0.5.8-cellsnp-lite_1.2.3-nextflow-compatible.sif'
}

process {
    container  = params.container
    executor   = 'lsf'
    queue      = { task.time <= 12.h ? 'normal' : 'long' }
    maxForks   = 5
}

executor {
    // Valid at executor scope only (not a process directive).
    perJobMemLimit = true
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B /lustre,/nfs'
    cacheDir   = '/nfs/cellgeni/singularity/images'
}
