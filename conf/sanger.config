// Sanger FARM (IBM LSF + Singularity). Mirrors nf-demultiplex conventions.

process {
    executor   = 'lsf'
    queue      = { task.time <= 12.h ? 'normal' : 'long' }
    maxForks   = 5
}

executor {
    // Valid at executor scope only (not a process directive).
    perJobMemLimit = true
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B /lustre,/nfs'
    cacheDir   = '/nfs/cellgeni/singularity/images'
}
