// Minimal test profile. Points at the tiny synthetic fixture shipped in test_data/.
// Designed for the LABEL_ONLY entry, which exercises the LABEL_MATERNAL_FETAL path
// end-to-end WITHOUT running Souporcell (no BAM/samtools needed):
//
//     nextflow run . -entry LABEL_ONLY -profile test
//
// For a full Souporcell run, use a real samplesheet (test_data/samplesheet_test.csv
// as a template) with -profile sanger,singularity. See docs/testing.md.

params {
    input  = "${projectDir}/test_data/samplesheet_label_test.csv"
    outdir = "results_test"

    // Fixture clusters are ~115 cells each; keep the default gate meaningful.
    min_cluster_cells = 20
}

process {
    cpus   = 1
    memory = 2.GB
}
