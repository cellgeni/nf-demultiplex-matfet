// End-to-end test profile on the synthetic two-group fixture (tests/make_fixture.py).
// Every row supplies souporcell_dir, so remapping is skipped; everything from the
// group matrix onwards runs for real, in the container, on the local executor:
//
//     python3 tests/make_fixture.py        # writes test_data/fixture/ (numpy + scipy)
//     nextflow run . -profile test
//
// See docs/testing.md for the expected verdicts.

params {
    input  = "${projectDir}/test_data/fixture/samplesheet.csv"
    outdir = "results_test"

    // Fixture panel header: one contig, matching the fixture's variants.
    soc_vcf = "${projectDir}/test_data/fixture/panel.vcf"

    // Fixture clusters are 78 and 380 cells; keep the default gate meaningful.
    min_cluster_cells = 20
}

process {
    executor = 'local'
    cpus     = 1
    memory   = 2.GB

    withName: 'SOUPORCELL_DISCOVERY' {
        cpus   = 2
        memory = 2.GB
    }
}
