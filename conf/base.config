// Default per-process resources. Overridden by conf/sanger.config on the farm.

process {
    container = params.container

    cpus   = 1
    memory = 2.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'finish' }
    maxRetries    = 1

    withName: 'SOUPORCELL' {
        cpus   = 16
        memory = 35.GB
        time   = 24.h
    }
    // Group matrix build + integrity check: validation measured 0.2-1.5 GB and
    // under 7 min per build for 1-5 libraries; scaled with headroom for 10-15.
    withName: 'BUILD_GROUP_MATRIX' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    // Validation measured CW5 (19,336 cells) 7.6 GB / 16 min and CW4 (36,800 cells)
    // 18.4 GB / 68 min, both with 4 threads. 10-15 library groups are unmeasured, so
    // memory doubles on each retry. Keep 4 cpus: the validated runs used 4 threads.
    withName: 'SOUPORCELL_DISCOVERY' {
        cpus       = 4
        memory     = { 24.GB * task.attempt }
        time       = { 8.h * task.attempt }
        maxRetries = 2
    }
    withName: 'MARKER_SUMMARY' {
        cpus   = 2
        memory = 16.GB
        time   = 2.h
    }
    withName: 'COMPOSITION_GATE|LABEL_CLUSTERS|SPLIT_BY_LIBRARY|BUILD_REPORT' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}
