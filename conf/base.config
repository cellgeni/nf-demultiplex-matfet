// Default per-process resources. Overridden by conf/sanger.config on the farm.

process {
    container = params.container

    cpus   = 1
    memory = 2.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'finish' }
    maxRetries    = 1

    withName: 'SOUPORCELL' {
        cpus   = 16
        memory = 35.GB
        time   = 24.h
    }
    withName: 'MARKER_SUMMARY' {
        cpus   = 2
        memory = 16.GB
        time   = 2.h
    }
    withName: 'LABEL_CLUSTERS|BUILD_REPORT' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}
